# Configuración de ejemplo para Kivly Loyalty
# Copia este archivo a .env y configura tus valores

# Credenciales de Kivly (obtener en https://getkivly.com/dashboard/integrations)
KIVLY_API_TOKEN=your_api_token_here
KIVLY_LOCATION_ID=your_location_id_here

# URL base de la API de Kivly
# Producción: https://api.getkivly.com
# Desarrollo: http://localhost:9900
KIVLY_BASE_URL=https://api.getkivly.com

# Webhook Secret para validación HMAC SHA256
# Generar con: openssl rand -hex 32
# O usar: python tools/generate_webhook_secret.py
KIVLY_WEBHOOK_SECRET=your_webhook_secret_here

# Configuración de sincronización
KIVLY_CUSTOMER_SYNC_ENABLED=true
KIVLY_CUSTOMER_SYNC_ONLY_WITH_PHONE=true

# URL base de Odoo (para webhooks)
# Debe ser accesible desde internet
ODOO_BASE_URL=https://your-odoo-instance.com
